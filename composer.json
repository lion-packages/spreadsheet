{
    "name": "lion/spreadsheet",
    "description": "Library to facilitate the use of spreadsheets.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lion\\Spreadsheet\\": "src/LionSpreadsheet/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpoffice/phpspreadsheet": "^2.2 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.12 || ^4.0",
        "lion/test": "^3.3 || ^4.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "overtrue/phplint": "^9.5",
        "infection/infection": "^0.29.14 || ^0.31.0 || ^0.32.0 || ^0.33.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
